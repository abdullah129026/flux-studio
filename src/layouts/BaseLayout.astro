---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { site } from "../data/site";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /* Motion mode for the Phase 3 pass: "home" gets the full choreography
     (process pin, counters, parallax), "detail" gets diagram drawing,
     "basic" gets reveals + split headings, "none" skips the motion bundle. */
  motion?: "home" | "detail" | "basic" | "none";
}

const { title, description = site.tagline, current = "/", ogImage = "/og/home.png", jsonLd, motion = "basic" } = Astro.props;
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();

const baseJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.name,
    url: site.url,
    logo: new URL("/favicon.svg", site.url).toString(),
    sameAs: [site.linkedin, site.github],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
  },
];
const allJsonLd = jsonLd
  ? [...baseJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : baseJsonLd;
---

<!doctype html>
<html lang="en" data-motion={motion}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b0e0c" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(allJsonLd)} />
    <script is:inline>
      // Set the theme before first paint. No-JS fallback is the OS preference
      // via the media query in tokens.css.
      (function () {
        try {
          var saved = localStorage.getItem("flux-theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.setAttribute("data-theme", saved);
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            document.documentElement.setAttribute("data-theme", "light");
          }
          // Only enable staged entrances when motion is welcome.
          if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.documentElement.classList.add("js");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <script>
      import "../scripts/motion.ts";
    </script>
    <script is:inline>
      (function () {
        // Theme toggle.
        var toggle = document.getElementById("theme-toggle");
        if (toggle) {
          toggle.addEventListener("click", function () {
            var el = document.documentElement;
            var next = el.getAttribute("data-theme") === "dark" ? "light" : "dark";
            el.setAttribute("data-theme", next);
            try {
              localStorage.setItem("flux-theme", next);
            } catch (e) {}
          });
        }

        // Mobile menu.
        var menu = document.getElementById("mobile-menu");
        var openBtn = document.getElementById("menu-open");
        var closeBtn = document.getElementById("menu-close");
        function setMenu(open) {
          if (!menu || !openBtn) return;
          menu.classList.toggle("open", open);
          menu.setAttribute("aria-hidden", open ? "false" : "true");
          openBtn.setAttribute("aria-expanded", open ? "true" : "false");
          document.body.style.overflow = open ? "hidden" : "";
          window.dispatchEvent(new CustomEvent("flux:menu", { detail: { open: open } }));
        }
        if (openBtn) openBtn.addEventListener("click", function () { setMenu(true); });
        if (closeBtn) closeBtn.addEventListener("click", function () { setMenu(false); });

        // Products nav dropdown (Resend-style hover, per the owner's spec).
        // Opens on hover/focus, stays open while the cursor is on the button
        // or the card, slides horizontally in the direction of travel when
        // moving between dropdown buttons. Touch taps toggle, Escape closes.
        (function () {
          var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var canHover = window.matchMedia("(hover: hover)").matches;
          var lastX = null;
          var closeTimer = null;
          var openToken = 0;

          function wraps() {
            return Array.prototype.slice.call(document.querySelectorAll("[data-dropdown]"));
          }

          function setOpen(wrap, open, dirX) {
            if (!wrap) return;
            var trigger = wrap.querySelector(".nav-dropdown-trigger");
            var panel = wrap.querySelector(".nav-dropdown-panel");
            if (open) {
              var slide = !reduceMotion && panel && typeof dirX === "number" && dirX !== 0;
              if (slide) {
                // Stage the directional offset instantly while the panel is
                // still closed (transitions disabled), then open on the next
                // frame so the slide animates from the correct side.
                var token = ++openToken;
                panel.style.setProperty("--drop-x", dirX * 18 + "px");
                panel.style.transition = "none";
                void panel.offsetWidth;
                panel.style.transition = "";
                requestAnimationFrame(function () {
                  if (token !== openToken) return;
                  wrap.setAttribute("data-open", "true");
                });
              } else {
                wrap.setAttribute("data-open", "true");
              }
            } else {
              openToken++;
              if (panel) panel.style.setProperty("--drop-x", "0px");
              wrap.setAttribute("data-open", "false");
              closeFlyoutsIn(wrap);
            }
            if (trigger) trigger.setAttribute("aria-expanded", open ? "true" : "false");
          }

          function closeAll(except) {
            wraps().forEach(function (w) { if (w !== except) setOpen(w, false); });
          }

          function openFrom(wrap) {
            var r = wrap.getBoundingClientRect();
            var x = r.left + r.width / 2;
            var dir = 0;
            if (lastX !== null && x !== lastX) dir = x > lastX ? 1 : -1;
            lastX = x;
            closeAll(wrap);
            setOpen(wrap, true, dir);
          }

          wraps().forEach(function (wrap) {
            var trigger = wrap.querySelector(".nav-dropdown-trigger");
            if (!trigger) return;

            // Escape closes the panel and refocuses the trigger; the focus
            // move itself must not trip the focusin opener below.
            var suppressFocusOpen = false;

            if (canHover) {
              wrap.addEventListener("mouseenter", function () {
                if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
                openFrom(wrap);
              });
              wrap.addEventListener("mouseleave", function () {
                closeTimer = setTimeout(function () { setOpen(wrap, false); }, 120);
              });
            } else {
              // Touch: tap toggles the panel (the trigger link itself stays
              // reachable through "View all products"; keyboard Enter still
              // follows the link, e.detail === 0). focusin does not open here
              // so a tap's focus event cannot race the toggle.
              trigger.addEventListener("click", function (e) {
                if (e.detail === 0) return;
                e.preventDefault();
                var isOpen = wrap.getAttribute("data-open") === "true";
                if (isOpen) setOpen(wrap, false);
                else openFrom(wrap);
              });
              document.addEventListener("click", function (e) {
                if (!wrap.contains(e.target)) setOpen(wrap, false);
              });
            }

            wrap.addEventListener("focusin", function () {
              if (suppressFocusOpen) return;
              if (canHover) openFrom(wrap);
            });
            trigger.addEventListener("keydown", function (e) {
              // ArrowDown on the trigger drops into the first submenu row.
              // Enter still follows the link (existing behavior).
              if (e.key === "ArrowDown") {
                e.preventDefault();
                var firstBtn = wrap.querySelector("[data-flyout] .nav-drop-rowbtn");
                if (firstBtn) firstBtn.focus();
              }
            });
            wrap.addEventListener("focusout", function (e) {
              if (!wrap.contains(e.relatedTarget)) setOpen(wrap, false);
            });
            wrap.addEventListener("keydown", function (e) {
              if (e.key === "Escape") {
                setOpen(wrap, false);
                suppressFocusOpen = true;
                trigger.focus();
                suppressFocusOpen = false;
              }
            });
          });

          // A scrolling page hides the header; never leave a panel floating.
          window.addEventListener("scroll", function () { closeAll(); }, { passive: true });

          // Nested flyouts: Live / In development / Upcoming rows inside the
          // Products panel. Hover opens, stays open while the cursor is on the
          // row or the flyout (180ms close delay covers the gap), and the
          // flyout slides in from the panel side.
          var flyTimer = null;

          function flyoutRows(scope) {
            var root = scope || document;
            return Array.prototype.slice.call(root.querySelectorAll("[data-flyout]"));
          }

          function setFlyout(row, open) {
            if (!row) return;
            var btn = row.querySelector(".nav-drop-rowbtn");
            var fly = row.querySelector(".nav-flyout");
            // Per-row token: every call invalidates this row's own pending
            // transition, so a close can never cancel another row's open
            // (or vice versa). Cross-row interference was the old bug.
            row.__flyToken = (row.__flyToken || 0) + 1;
            if (open) {
              var slide = !reduceMotion && fly;
              if (slide) {
                var token = row.__flyToken;
                fly.style.setProperty("--fly-x", "-14px");
                fly.style.transition = "none";
                void fly.offsetWidth;
                fly.style.transition = "";
                requestAnimationFrame(function () {
                  if (row.__flyToken !== token) return;
                  row.setAttribute("data-open", "true");
                });
              } else {
                row.setAttribute("data-open", "true");
              }
            } else {
              if (fly) fly.style.setProperty("--fly-x", "0px");
              row.setAttribute("data-open", "false");
            }
            if (btn) btn.setAttribute("aria-expanded", open ? "true" : "false");
          }

          function closeFlyouts(except) {
            flyoutRows().forEach(function (r) { if (r !== except) setFlyout(r, false); });
          }

          function closeFlyoutsIn(wrap) {
            flyoutRows(wrap).forEach(function (r) { setFlyout(r, false); });
          }

          flyoutRows().forEach(function (row) {
            var btn = row.querySelector(".nav-drop-rowbtn");
            if (!btn) return;

            if (canHover) {
              row.addEventListener("mouseenter", function () {
                if (flyTimer) { clearTimeout(flyTimer); flyTimer = null; }
                closeFlyouts(row);
                setFlyout(row, true);
              });
              row.addEventListener("mouseleave", function () {
                flyTimer = setTimeout(function () { setFlyout(row, false); }, 180);
              });
            } else {
              // Touch: tap the row to toggle its flyout; tapping a product
              // link navigates. Keyboard Enter is handled below, so guard
              // against the focus event racing the toggle is not needed here
              // because buttons do not navigate.
              btn.addEventListener("click", function () {
                var isOpen = row.getAttribute("data-open") === "true";
                if (isOpen) setFlyout(row, false);
                else { closeFlyouts(row); setFlyout(row, true); }
              });
              document.addEventListener("click", function (e) {
                if (!row.contains(e.target)) setFlyout(row, false);
              });
            }

            // Keyboard: Up/Down move between rows, Right/Enter opens the
            // flyout and lands on the first product, Left/Escape closes back
            // to the row.
            btn.addEventListener("keydown", function (e) {
              var all = flyoutRows();
              var i = all.indexOf(row);
              if (e.key === "ArrowDown") {
                e.preventDefault();
                all[(i + 1) % all.length].querySelector(".nav-drop-rowbtn").focus();
              } else if (e.key === "ArrowUp") {
                e.preventDefault();
                all[(i - 1 + all.length) % all.length].querySelector(".nav-drop-rowbtn").focus();
              } else if (e.key === "ArrowRight" || e.key === "Enter") {
                e.preventDefault();
                closeFlyouts(row);
                setFlyout(row, true);
                // Focus only after the flyout is visible; focusing a link
                // inside a visibility:hidden container is a no-op.
                var first = row.querySelector(".nav-flyout a");
                if (first) {
                  requestAnimationFrame(function () {
                    requestAnimationFrame(function () { first.focus(); });
                  });
                }
              } else if (e.key === "ArrowLeft" || e.key === "Escape") {
                // Flyout already closed: let Escape bubble to the
                // panel-level handler, which closes the panel and refocuses
                // the trigger. Otherwise close just the flyout.
                if (row.getAttribute("data-open") !== "true") return;
                e.preventDefault();
                e.stopPropagation();
                setFlyout(row, false);
                btn.focus();
              }
            });

            var fly = row.querySelector(".nav-flyout");
            if (fly) {
              fly.addEventListener("keydown", function (e) {
                var links = Array.prototype.slice.call(fly.querySelectorAll("a"));
                var i = links.indexOf(document.activeElement);
                if (e.key === "ArrowDown") {
                  e.preventDefault();
                  links[(i + 1) % links.length].focus();
                } else if (e.key === "ArrowUp") {
                  e.preventDefault();
                  links[(i - 1 + links.length) % links.length].focus();
                } else if (e.key === "ArrowLeft" || e.key === "Escape") {
                  e.preventDefault();
                  e.stopPropagation();
                  setFlyout(row, false);
                  btn.focus();
                } else if (e.key === "Tab" && !e.shiftKey && i === links.length - 1) {
                  setFlyout(row, false);
                }
              });
            }
          });
        })();

        // Shipping feed stream-in. Items are visible without JS; with JS they
        // enter in sequence, staggered by the --i custom property in CSS.
        var items = document.querySelectorAll(".feed-item");
        if (items.length && document.documentElement.classList.contains("js")) {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              items.forEach(function (item) { item.classList.add("is-in"); });
            });
          });
        }

        // Header hides on scroll down, reveals on scroll up.
        var header = document.querySelector(".site-header");
        var lastY = window.scrollY;
        function onScrollHeader() {
          var y = window.scrollY;
          if (header) {
            if (y > 240 && y > lastY) header.classList.add("is-hidden");
            else header.classList.remove("is-hidden");
          }
          lastY = y;
        }

        // Scroll progress bar.
        var progress = document.getElementById("scroll-progress");
        function onScrollProgress() {
          if (!progress) return;
          var max = document.documentElement.scrollHeight - window.innerHeight;
          var ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          progress.style.transform = "scaleX(" + ratio + ")";
        }

        var ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            onScrollHeader();
            onScrollProgress();
            ticking = false;
          });
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScrollProgress();
      })();
    </script>
  </body>
</html>
