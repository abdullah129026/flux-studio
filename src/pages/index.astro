<script is:inline src="/js/three.min.js"></script>
<script is:inline>
  var PRODUCTS = {
    patchpilot:{title:"PatchPilot",status:"Live demo",desc:"Paste a GitHub issue link. PatchPilot reproduces the bug inside Docker, then writes the failing test and a fix diff. Attempts after the first get the previous exit code and a capped log tail, so it learns from its own failure inside the run.",stack:"Docker, EC2 agent service, Qwen3-Coder",best:"Maintainers who need a reproduction before they need an opinion.",link:"https://patchpilot-shah20.vercel.app"},
    trace:{title:"Trace",status:"Live",desc:"Like Figma, but for debugging. Multiple people watch code execute live, line by line, with variables, stack and an AI explanation you can scrub back through.",stack:"Yjs, WebSockets, sandboxed Python and JS runtimes",best:"Teaching, pairing and debugging sessions that need a shared view of execution.",link:"https://trace-swwy.vercel.app"},
    ghostcode:{title:"GhostCode",status:"Live",desc:"Turns dead code into a P and L statement. It finds what your codebase carries but never runs, and puts a maintenance cost next to it.",stack:"Static analysis across a real codebase",best:"Teams carrying legacy code nobody wants to defend or delete.",link:"https://ghostcode-shah20.vercel.app"},
    acf:{title:"API Contract Firewall",status:"Live",desc:"Sits in front of your API, learns its real contracts from traffic, and flags breaking changes before your consumers find them in production.",stack:"Live proxy with a contract learning loop",best:"API owners who ship changes other teams depend on.",link:"https://api-contract-firewall.vercel.app"},
    spec2run:{title:"Spec2Run",status:"Live, v1.0",desc:"Takes a written spec and turns it into a runnable starting point, so the gap between deciding what to build and having something to run gets much smaller.",stack:"Spec parsing and project generation",best:"Builders who write the spec first and want momentum from it.",link:"https://spec2run.fluxyai.codes"},
