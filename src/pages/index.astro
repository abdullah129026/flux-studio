  };
  var pd = document.getElementById('productDialog');
  var cd = document.getElementById('contactDialog');
  function openDialog(d){
    if (document.startViewTransition) { document.startViewTransition(function(){ d.showModal(); }); }
    else { d.showModal(); }
  }
  document.querySelectorAll('[data-product]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var p = PRODUCTS[btn.getAttribute('data-product')]; if(!p) return;
      document.getElementById('pdTitle').textContent = p.title;
      document.getElementById('pdDesc').textContent = p.desc;
      document.getElementById('pdStack').textContent = p.stack;
      document.getElementById('pdStatus').textContent = p.status;
      document.getElementById('pdStatus2').textContent = p.status;
      document.getElementById('pdFor').textContent = p.best;
      var link = document.getElementById('pdLink');
      if (p.link) { link.href = p.link; link.style.display = 'inline-flex'; } else { link.style.display = 'none'; }
      openDialog(pd);
    });
  });
  document.querySelectorAll('[data-open-contact]').forEach(function(b){ b.addEventListener('click', function(){ openDialog(cd); }); });
  document.querySelectorAll('[data-close]').forEach(function(b){ b.addEventListener('click', function(){ b.closest('dialog').close(); }); });
  [pd, cd].forEach(function(d){ d.addEventListener('click', function(e){ if (e.target === d) d.close(); }); });
  // Products dropdown: anchor it under the Products button, not the page corner.
  // The popover has no positioned ancestor, so place it from the button's rect
  // whenever it opens (beforetoggle / button click both run before it paints).
  var productsBtn = document.getElementById('productsBtn');
  var allProducts = document.getElementById('allProducts');
  function positionProductsMenu(){
    if (!productsBtn || !allProducts) return;
    var r = productsBtn.getBoundingClientRect();
    var w = Math.min(420, window.innerWidth - 32);
    var left = Math.max(16, Math.min(r.left, window.innerWidth - w - 16));
    allProducts.style.left = left + 'px';
    allProducts.style.right = 'auto';
    allProducts.style.top = (r.bottom + 10) + 'px';
  }
  if (productsBtn && allProducts) {
    productsBtn.addEventListener('click', positionProductsMenu);
    allProducts.addEventListener('beforetoggle', function(e){ if (e.newState === 'open') positionProductsMenu(); });
    allProducts.addEventListener('toggle', function(e){ productsBtn.setAttribute('aria-expanded', e.newState === 'open' ? 'true' : 'false'); });
    allProducts.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){ if (allProducts.hidePopover) { try { allProducts.hidePopover(); } catch (err) {} } });
    });
    addEventListener('resize', function(){ if (allProducts.matches(':popover-open')) positionProductsMenu(); }, {passive:true});
  }
  // Fallback for scroll progress where scroll timelines are not supported
  if (!CSS.supports('animation-timeline: scroll()')) {
    var bar = document.querySelector('.progress');
    addEventListener('scroll', function(){
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      bar.style.transform = 'scaleX(' + (max > 0 ? h.scrollTop / max : 0) + ')';
    }, {passive:true});
  }

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Seamless ticker: duplicate the group once so the -50% loop has no gap
  var tickerTrack = document.getElementById('tickerTrack');
  if (tickerTrack && tickerTrack.children.length === 1) {
    var clone = tickerTrack.children[0].cloneNode(true);
    clone.setAttribute('aria-hidden','true');
    tickerTrack.appendChild(clone);
  }

  // Header shadow on scroll
  var siteHeader = document.querySelector('header.site');
  addEventListener('scroll', function(){ if (siteHeader) siteHeader.classList.toggle('scrolled', window.scrollY > 8); }, {passive:true});

  // Terminal: play when it enters view, replay on demand
  var terminal = document.getElementById('terminal');
  function playTerminal(){ if (!terminal) return; terminal.classList.remove('play'); void terminal.offsetWidth; terminal.classList.add('play'); }
  if (terminal) {
    if (reduceMotion) { terminal.classList.add('play'); }
    else if ('IntersectionObserver' in window) {
      var termObs = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if (e.isIntersecting) { playTerminal(); termObs.disconnect(); } }); }, {threshold:.35});
      termObs.observe(terminal);
    } else { playTerminal(); }
    var replayBtn = document.getElementById('replayTerm');
    if (replayBtn) replayBtn.addEventListener('click', playTerminal);
    // Subtle tilt on fine pointers only
    if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      var heroGrid = document.querySelector('.hero-grid');
      terminal.addEventListener('pointermove', function(ev){
        var r = terminal.getBoundingClientRect();
        var x = (ev.clientX - r.left) / r.width - .5;
        var y = (ev.clientY - r.top) / r.height - .5;
        terminal.style.transform = 'perspective(900px) rotateY(' + (x*3.2).toFixed(2) + 'deg) rotateX(' + (-y*3.2).toFixed(2) + 'deg)';
      });
      terminal.addEventListener('pointerleave', function(){ terminal.style.transform = ''; terminal.style.transition = 'transform .5s cubic-bezier(.22,1,.36,1)'; setTimeout(function(){ terminal.style.transition=''; }, 520); });
    }
  }

  // Reveal on scroll + count up
  function animateCount(el){
    var target = parseInt(el.getAttribute('data-count'), 10);
    if (isNaN(target) || reduceMotion) return;
    var start = null;
    function step(ts){ if (!start) start = ts; var p = Math.min((ts - start) / 900, 1); var eased = 1 - Math.pow(1 - p, 3); el.textContent = Math.round(target * eased); if (p < 1) requestAnimationFrame(step); }
    requestAnimationFrame(step);
  }
  var revealEls = document.querySelectorAll('.will-reveal, .stagger');
  if ('IntersectionObserver' in window && !reduceMotion) {
    var revealObs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in'); revealObs.unobserve(e.target); } });
    }, {threshold:.18, rootMargin:'0px 0px -6% 0px'});
    revealEls.forEach(function(el){ revealObs.observe(el); });
  } else {
    revealEls.forEach(function(el){ el.classList.add('in'); });
  }
  var counters = document.querySelectorAll('[data-count]');
  if ('IntersectionObserver' in window && !reduceMotion) {
    var countObs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) { animateCount(e.target); countObs.unobserve(e.target); } });
    }, {threshold:.6});
    counters.forEach(function(el){ countObs.observe(el); });
  }

  // 3D logo stages: the original emerald curved X from the live site logo
  // (assets/favicon.svg, viewBox 0 0 64 64) rebuilt as two bent tubes.
  // Stroke 1: M 15 11 C 29 27, 37 41, 49 55. Stroke 2: M 49 11 C 35 27, 27 41, 15 55.
  // Mapped with x' = (x - 32) / 23.5, y' = (33 - y) / 22.5, plus a z bow so the
  // crossing reads in 3D. If WebGL or three.js is unavailable the logo image
  // fallback inside each stage simply stays visible.
  (function(){
    var stages = document.querySelectorAll('[data-stage3d]');
    if (!stages.length || !window.THREE) return;

    function initStage(stage, staticFrame){
      var W = stage.clientWidth || 480;
      var H = stage.clientHeight || 220;
      var renderer = new THREE.WebGLRenderer({antialias:true, alpha:true});
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(W, H);
      if ('outputColorSpace' in renderer) renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.12;

      var scene = new THREE.Scene();
      var camera = new THREE.PerspectiveCamera(38, W / H, .1, 100);
      camera.position.set(0, .35, 7.4);

      var pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new THREE.RoomEnvironment(), .04).texture;
      scene.add(new THREE.AmbientLight(0xffffff, .35));
      var key = new THREE.DirectionalLight(0xffffff, 1.1); key.position.set(3, 4, 5); scene.add(key);
      var rim = new THREE.DirectionalLight(0x9ff5cf, .7); rim.position.set(-4, 2, -3); scene.add(rim);

      var mat = new THREE.MeshPhysicalMaterial({color:0x2fbf71, roughness:.22, metalness:.05, clearcoat:.7, clearcoatRoughness:.25});
      var group = new THREE.Group();
      var strokeA = [new THREE.Vector3(-.72, .98, 0), new THREE.Vector3(-.13, .27, .36), new THREE.Vector3(.21, -.36, .36), new THREE.Vector3(.72, -.98, 0)];
      var strokeB = [new THREE.Vector3(.72, .98, 0), new THREE.Vector3(.13, .27, -.36), new THREE.Vector3(-.21, -.36, -.36), new THREE.Vector3(-.72, -.98, 0)];
      [strokeA, strokeB].forEach(function(pts){
        var curve = new THREE.CubicBezierCurve3(pts[0], pts[1], pts[2], pts[3]);
        group.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 48, .30, 24, false), mat));
      });
      group.rotation.set(-.12, .5, 0);
      scene.add(group);

      var N = 90, pos = new Float32Array(N * 3);
      for (var i = 0; i < N; i++) {
        pos[i * 3] = (Math.random() * 2 - 1) * 3.4;
        pos[i * 3 + 1] = (Math.random() * 2 - 1) * 1.7;
        pos[i * 3 + 2] = (Math.random() * 2 - 1) * 1.2;
      }
      var pg = new THREE.BufferGeometry();
      pg.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      var sc = document.createElement('canvas'); sc.width = sc.height = 64;
      var sx = sc.getContext('2d');
      var grad = sx.createRadialGradient(32, 32, 2, 32, 32, 30);
      grad.addColorStop(0, 'rgba(255,255,255,1)'); grad.addColorStop(1, 'rgba(255,255,255,0)');
      sx.fillStyle = grad; sx.fillRect(0, 0, 64, 64);
      var points = new THREE.Points(pg, new THREE.PointsMaterial({size:.09, map:new THREE.CanvasTexture(sc), color:0x35b06f, transparent:true, opacity:.55, depthWrite:false}));
      scene.add(points);

      stage.appendChild(renderer.domElement);
      renderer.render(scene, camera);
      var fb = stage.querySelector('.stage-fallback');
      if (fb) fb.style.display = 'none';
      if (staticFrame) return;

      var targetRX = -.12, targetRY = .5, dragging = false, px = 0, py = 0;
      var nx = 0, ny = 0, visible = true, raf = 0, t0 = performance.now();
      var el = renderer.domElement;
      el.addEventListener('pointerdown', function(e){ dragging = true; px = e.clientX; py = e.clientY; try { el.setPointerCapture(e.pointerId); } catch (err) {} });
      el.addEventListener('pointermove', function(e){
        if (!dragging) return;
        targetRY += (e.clientX - px) * .01;
        targetRX += (e.clientY - py) * .008;
        if (targetRX > 1.1) targetRX = 1.1; if (targetRX < -1.1) targetRX = -1.1;
        px = e.clientX; py = e.clientY;
      });
      function endDrag(){ dragging = false; }
      el.addEventListener('pointerup', endDrag);
      el.addEventListener('pointercancel', endDrag);
      addEventListener('pointermove', function(e){
        nx = e.clientX / window.innerWidth - .5;
        ny = e.clientY / window.innerHeight - .5;
      }, {passive:true});

      function resize(){
        var w = stage.clientWidth, h = stage.clientHeight;
        if (!w || !h) return;
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
      if ('ResizeObserver' in window) { new ResizeObserver(resize).observe(stage); }
      else { addEventListener('resize', resize); }

      function frame(now){
        raf = requestAnimationFrame(frame);
        var t = (now - t0) / 1000;
        if (!dragging) targetRY += .0035;
        group.rotation.x += (targetRX - group.rotation.x) * .07;
        group.rotation.y += (targetRY - group.rotation.y) * .07;
        group.position.y = Math.sin(t * 1.1) * .07;
        points.rotation.y = t * .02;
        camera.position.x += (nx * .55 - camera.position.x) * .04;
        camera.position.y += (.35 - ny * .4 - camera.position.y) * .04;
        camera.lookAt(0, 0, 0);
        renderer.render(scene, camera);
      }
      function start(){ if (!raf) raf = requestAnimationFrame(frame); }
      function stop(){ if (raf) { cancelAnimationFrame(raf); raf = 0; } }
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function(entries){
          entries.forEach(function(en){ visible = en.isIntersecting; if (visible) start(); else stop(); });
        }, {threshold:.05}).observe(stage);
      }
      start();
    }

    // Init is deferred until a stage nears the viewport, so WebGL setup never
    // blocks first paint or DOMContentLoaded. The CTA stage (data-lazy) only
    // starts when scrolled near, and its loop above only renders on screen.
    stages.forEach(function(stage){
      function boot(){
        try { initStage(stage, reduceMotion); } catch (e) {}
      }
      if ('IntersectionObserver' in window) {
        var lo = new IntersectionObserver(function(entries){
          entries.forEach(function(en){
            if (en.isIntersecting) { lo.disconnect(); requestAnimationFrame(boot); }
          });
        }, {rootMargin:'320px 0px'});
        lo.observe(stage);
      } else if (document.readyState === 'complete') { boot(); }
      else { addEventListener('load', boot); }
    });
  })();
</script>

