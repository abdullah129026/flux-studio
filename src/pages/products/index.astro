---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductExplorer from "../../components/ProductExplorer.astro";
---

<BaseLayout
  title="Products"
  current="/products"
  description="Every product Flux Studio has shipped or is building, with its status. Live means you can use it today."
  ogImage="/og/products.png"
>
  <div class="container page-intro">
    <p class="section-eyebrow">Products</p>
    <h1 class="page-title" data-split>Everything we ship, listed with its status.</h1>
    <p class="page-lede">
      Live means you can use it today. In development means it is being built
      in the open. Upcoming means it is next in the sequence.
    </p>
  </div>
  <div class="container">
    <ProductExplorer />
  </div>
</BaseLayout>
