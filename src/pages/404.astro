---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page never shipped.">
  <div class="container not-found">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 class="not-found-title">This page never shipped.</h1>
    <p>
      It does not exist, or it moved without leaving a changelog entry.
      The studio, on the other hand, is right here.
    </p>
    <p class="not-found-links">
      <a href="/">Back to the studio</a>
      <a href="/products">Browse the products</a>
    </p>
  </div>
</BaseLayout>
